+                    ("Winchester WSR", "General purpose"),
+                    ("Norma Small Rifle", "Good value"),
+                ]
+            else:
+                recommendations = [
+                    ("Winchester WLR", "Most economical"),
+                    ("Federal 210", "Standard Large Rifle"),
+                    ("Norma Large Rifle", "Consistent and affordable"),
+                ]
+
+        else:  # Hunting
