+        plt.plot([1, 2, 3], [4, 5, 6])
+        plt.title("Eksempelrapport")
+        with PdfPages(file_path) as pdf:
+            pdf.savefig(fig)
+        plt.close(fig)
+        QMessageBox.information(self, "PDF eksport", f"Rapport lagret til {file_path}")
