+            "rifle_id": None,
+            "notes": "Demo optic not linked",
+        },
+    ]
+    optic_ids = []
+    for o in optics:
+        ex = db.execute_query("SELECT id FROM optics WHERE name = ?", (o["name"],))
+        if ex:
+            oid = ex[0]["id"]
+        else:
+            # Insert optics with only existing columns
+            ocols = [
+                r[1] for r in db.cursor.execute("PRAGMA table_info(optics)").fetchall()
