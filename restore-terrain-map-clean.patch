+            return "Headwind/Tailwind"
+        elif angle < 30:
+            return "Slight crosswind"
+        elif angle < 60:
+            return "Half-value crosswind"
+        elif angle < 120:
+            return "Full-value crosswind"
+        elif angle < 150:
+            return "Half-value crosswind"
+        else:
+            return "Slight crosswind"
