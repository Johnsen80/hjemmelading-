+        max_size = 600
+        if height > max_size or width > max_size:
+            scale = min(max_size / height, max_size / width)
+            new_width = int(width * scale)
+            new_height = int(height * scale)
+            rgb_image = cv2.resize(rgb_image, (new_width, new_height))
