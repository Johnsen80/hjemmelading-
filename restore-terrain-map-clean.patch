+
+        <h4>Top Recommendations:</h4>
+        <ol>
+        """
+
+        for name, reason in recommendations[:3]:
+            html += f"<li><b>{name}</b> - {reason}</li>"
+
+        html += """
+        </ol>
+        </div>
+        """
+
+        # Add powder-specific advice
