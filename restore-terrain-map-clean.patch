+
+                    # Data
+                    for row in range(self.drop_table.rowCount()):
+                        row_data = []
+                        for col in range(self.drop_table.columnCount()):
+                            item = self.drop_table.item(row, col)
+                            row_data.append(item.text() if item else "")
+                        f.write(",".join(row_data) + "\n")
