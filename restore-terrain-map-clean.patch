+        elif "anbefal" in question.lower() or "match" in question.lower():
+            best = self.get_best_ammo()
+            if best:
+                self.ai_output.setText(
+                    f"Anbefalt ammo: {best['ammo']} batch {best['batch']} (samling {best['group']} mm)"
