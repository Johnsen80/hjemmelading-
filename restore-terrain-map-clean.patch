+    def save_rounds(self):
+        """Save rounds fired"""
+        rounds_to_add = self.input_rounds.value()
+        current_count = self.rifle.get("round_count", 0) or 0
+        new_count = current_count + rounds_to_add
+
+        # Update rifle
