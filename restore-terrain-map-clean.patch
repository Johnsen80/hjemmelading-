+            # Forventet format (eksempel):
+            # [
+            #   {
+            #     "name": "6.5 CM ELD-M 140gr",
+            #     "velocity_fps": 2750,
+            #     "max_pressure_psi": 58000,
+            #     "case_fill_percent": 98.5,
