+                    <li><b>Gruppe:</b> {best.get('group_size_moa', 'N/A')} MOA</li>
+                    <li><b>Score for formål:</b> {best.get('score', 0):.1f}/100</li>
+                </ul>
+                </div>
+                <br>
+            """
+
+        recommendation += f"""
+            <h3>📋 Tips for {profile['name']}:</h3>
