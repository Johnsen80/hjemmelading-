+-
+-    This is intentionally synchronous if no `NetworkWorker` is available;
+-    callers should run it off the UI thread when used in GUIs.
+-    """
+-    if not _HAS_REQUESTS:
+-        return
+-    try:
+-        lat = (
+-            float(viewer.shooter_lat.value())
+-            if getattr(viewer, "shooter_lat", None) is not None
+-            else 59.9139
+-        )
+-        lon = (
+-            float(viewer.shooter_lon.value())
+-            if getattr(viewer, "shooter_lon", None) is not None
+-            else 10.7522
+-        )
+-    except Exception:
+-        return
+-
+-    def _write_result(res: Optional[dict]) -> None:
+-        if getattr(viewer, "weather_display", None) is not None:
+-            try:
+-                viewer.weather_display.setText(str(res)[:2000])
+-            except Exception:
+-                pass
+-
+-    if NetworkWorker is None:
+-        res = fetch_weather_data_owm(lat, lon, api_key)
+-        _write_result(res)
+-        return
+-
+-    def _task(a: float, b: float, key: Optional[str] = None) -> Optional[dict]:
+-        return fetch_weather_data_owm(a, b, key)
+-
+-    worker = NetworkWorker(_task, args=(lat, lon, api_key))
+-
+-    def _on_finished(result: Optional[dict]) -> None:
+-        _write_result(result)
+-
+-    def _on_error(exc: Exception) -> None:  # pragma: no cover - best-effort
+-        logger.debug("fetch_weather_for_viewer_async error: %s", exc)
+-
+-    worker.on_finished = _on_finished
+-    worker.on_error = _on_error
+-    try:
+-        worker.start()
+-    except Exception as exc:  # pragma: no cover - thread start failures
+-        logger.debug("Could not start NetworkWorker: %s", exc)
+-
+-
+-def get_elevation(lat: float, lon: float) -> Optional[float]:
+-    """Synchronous elevation lookup using OpenTopoData. Returns None on failure."""
+-    if not _HAS_REQUESTS or requests is None:
+-        return None
+-    try:
+-        url = f"https://api.opentopodata.org/v1/srtm30m?locations={lat},{lon}"
+-        resp = requests.get(url, timeout=10)
+-        resp.raise_for_status()
+-        data = resp.json()
+-        results = data.get("results", []) if isinstance(data, dict) else []
+-        if not results:
+-            return None
+-        entry = results[0]
+-        return entry.get("elevation")
+-    except Exception as exc:  # pragma: no cover - network
+-        logger.debug("get_elevation failed: %s", exc)
+-        try:
+-            append_exception("get_elevation failed", exc)
+-        except Exception:
+-            pass
+-        return None
+-
+-
+-def _safe_add_marker(
+-    map_obj: Any, location: Tuple[float, float], popup: Optional[str] = None
+-) -> None:
+-    if not _HAS_FOLIUM or folium is None or map_obj is None:
+-        return
+-    try:
+-        folium.Marker(location=location, popup=popup).add_to(map_obj)
+-    except Exception as exc:  # pragma: no cover - best-effort
+-        logger.debug("_safe_add_marker failed: %s", exc)
+-
+-
+-def _safe_add_polyline(
+-    map_obj: Any, locations: List[Tuple[float, float]], **_: Any
+-) -> None:
+-    if not _HAS_FOLIUM or folium is None or map_obj is None:
+-        return
+-    try:
+-        folium.PolyLine(locations=locations).add_to(map_obj)
+-    except Exception as exc:  # pragma: no cover - best-effort
+-        logger.debug("_safe_add_polyline failed: %s", exc)
+-
+-
+-class PurposeSelectionDialog:
+-    """Minimal non-GUI selection shim used by tests/CI."""
+-
+-    def __init__(self, parent: Optional[Any] = None) -> None:
+-        self._choice = "range"
+-
+-    def get_purpose(self) -> str:
+-        return self._choice
+-
+-
+-class TerrainMapViewer:
+-    """Very small non-GUI viewer shim used by helpers and tests.
+-
+-    The full PyQt-based UI belongs in a separate module so this file
+-    remains importable without PyQt.
+-    """
+-
+-    def __init__(self, parent: Optional[Any] = None, db: Optional[Any] = None) -> None:
+-        self.parent = parent
+-        self.db = db
+-        self.map_view: Optional[Any] = None
+-        self.current_map: Optional[Any] = None
+-        self.results_text: Optional[Any] = None
+-        self.shooter_lat: Optional[Any] = None
+-        self.shooter_lon: Optional[Any] = None
+-        self.weather_display: Optional[Any] = None
+-        self.current_language = "no"
+-
+-    def init_ui(self) -> None:
+-        """Placeholder for UI wiring done elsewhere."""
+-        return None
+-
+-    def request_weather_async(self, api_key: Optional[str] = None) -> None:
+-        try:
+-            fetch_weather_for_viewer_async(self, api_key=api_key)
+-        except Exception as exc:
+-            logger.debug("request_weather_async failed: %s", exc)
+-
+-    def fetch_weather_sync(self, api_key: Optional[str] = None) -> Optional[dict]:
+-        try:
+-            lat = (
+-                float(self.shooter_lat.value())
+-                if getattr(self, "shooter_lat", None) is not None
+-                else 59.9139
+-            )
+-            lon = (
+-                float(self.shooter_lon.value())
+-                if getattr(self, "shooter_lon", None) is not None
+-                else 10.7522
+-            )
+-        except Exception:
+-            return None
+-        return fetch_weather_data_owm(lat, lon, api_key)
+-
+-    def analyze_shot(self) -> None:
+-        if getattr(self, "results_text", None) is not None:
+-            try:
+-                self.results_text.setText("Analyserer skudd... (baseline)")
+-            except Exception:
+-                pass
+-
+-
+-__all__ = [
+-    "TerrainMapViewer",
+-    "PurposeSelectionDialog",
+-    "_safe_add_marker",
+-    "_safe_add_polyline",
+-    "get_elevation",
+-    "fetch_weather_data_owm",
+-    "fetch_weather_for_viewer_async",
+-]
+-- 
+2.52.0.windows.1
+
