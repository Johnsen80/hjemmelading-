+                recommendations = [
+                    ("CCI 450", "Magnum ensures ignition"),
+                    ("Federal 205", "Reliable"),
+                ]
+            else:
+                recommendations = [
+                    ("Federal 215M", "For slow powders in magnums"),
+                    ("CCI BR-2", "Excellent all-rounder"),
+                    ("Remington 9½", "Magnum for big cases"),
+                ]
+
+        # Format recommendation
