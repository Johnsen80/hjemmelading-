+  console.log('Saved:', p1.id);
+
+  console.log('Saving duplicate powder (name only)...');
+  const p2 = await db.save('powders', { name: 'IMR 4064' });
+  console.log('Result id (should match previous):', p2.id);
+
+  const powders = await db.list('powders');
