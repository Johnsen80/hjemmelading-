+                recommendations = [
+                    ("CCI 450", "Best for match, magnum cup handles ball powders well"),
+                    ("Federal 205M", "Gold standard for .223 match"),
+                    ("Remington 7½", "Classic benchrest choice"),
+                    ("Murom KVB-223", "Russian match quality, very consistent"),
