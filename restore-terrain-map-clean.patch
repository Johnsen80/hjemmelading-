+            "#3498db",
+            "#e74c3c",
+            "#2ecc71",
+            "#f39c12",
+            "#9b59b6",
+            "#1abc9c",
+            "#34495e",
+            "#e67e22",
+            "#95a5a6",
+            "#d35400",
+        ]
+
+        self._setup_plot()
+
+    def _setup_plot(self):
+        """Setup target overlay"""
+        if self.ax is None:
+            return
+        self.ax.clear()
+        self.ax.set_xlim(-3, 3)
+        self.ax.set_ylim(-3, 3)
+        self.ax.set_aspect("equal")
+        self.ax.set_xlabel("Horizontal (inches)", fontsize=10)
+        self.ax.set_ylabel("Vertical (inches)", fontsize=10)
