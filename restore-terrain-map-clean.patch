+            self.spin_target_coal.value(), self.spin_coal_tolerance.value(), '"'
+        )
+        self.live_hist_coal.clear_data()
+
+        self.live_hist_case.set_target(None, None, "gr")
+        self.live_hist_case.clear_data()
