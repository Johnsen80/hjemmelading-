+
+        ax1.set_xlabel("COAL (mm)", fontsize=11)
+        ax1.set_ylabel("Gruppestørrelse (mm)", fontsize=11)
+        ax1.set_title("Gruppestørrelse vs Settedybde", fontsize=12, fontweight="bold")
+        ax1.grid(True, alpha=0.3)
+
+        # Plot 2: SD vs COAL
