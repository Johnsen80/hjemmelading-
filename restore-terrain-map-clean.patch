+                f"⚠️ <b>Case veldig kort:</b> {case_length:.3f}\" < {self.current_spec['case_length_trim']:.3f}\""
+            )
+            warnings.append("   <i>OK å bruke, men uvanlig kort. Sjekk måling.</i>")
+        else:
+            ok.append(f'✅ <b>Case Length OK:</b> {case_length:.3f}"')
+
+        # Check pressure
