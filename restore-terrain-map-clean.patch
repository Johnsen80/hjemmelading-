+                    table_name,
+                    component_id,
+                    data["lot_number"],
+                    data["purchase_date"],
+                    data["quantity"],
+                    data["quantity"],
+                    1,
+                    data["notes"],
+                ),
+            )
+            self.db.conn.commit()
