+    def _setup_empty_plot(self):
+        """Setup empty trajectory plot"""
+        self.ax.clear()
+        self.ax.set_xlabel("Distance (yards)", fontsize=12, fontweight="bold")
+        self.ax.set_ylabel("Drop (inches)", fontsize=12, fontweight="bold")
+        self.ax.set_title(
