{
    "python.defaultInterpreterPath": "C:\\Users\\bjjoh\\OneDrive\\Dokumenter\\Programering\\Hjemmelading\\.github\\.tool-venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,

    "window.zoomLevel": -1,

    "editor.fontSize": 14,
    "editor.lineHeight": 1.55,
    "editor.fontFamily": "Consolas, 'Cascadia Code', 'Courier New', monospace",
    "editor.fontLigatures": false,
    "editor.letterSpacing": 0.3,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "none",
    "editor.scrollBeyondLastLine": false,
    "editor.wordWrap": "off",
    "editor.rulers": [100],
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.semanticHighlighting.enabled": true,
    "editor.tokenColorCustomizations": {
        "comments": "#6a9955",
        "strings": "#ce9178",
        "keywords": "#569cd6",
        "functions": "#dcdcaa",
        "variables": "#9cdcfe",
        "types": "#4ec9b0",
        "numbers": "#b5cea8"
    },
    "editor.colorDecorators": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "editor.padding.top": 8,

    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "vs-seti",
    "workbench.tree.indent": 14,
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.showTabs": "multiple",
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.activityBar.location": "default",
    "workbench.colorCustomizations": {
        "editor.background": "#0d1117",
        "editor.foreground": "#e6edf3",
        "editorLineNumber.foreground": "#3d4450",
        "editorLineNumber.activeForeground": "#6e7681",
        "editor.lineHighlightBackground": "#161b22",
        "editor.selectionBackground": "#264f78",
        "editorIndentGuide.background1": "#21262d",
        "editorIndentGuide.activeBackground1": "#3d4450",
        "sideBar.background": "#010409",
        "sideBarSectionHeader.background": "#0d1117",
        "activityBar.background": "#010409",
        "statusBar.background": "#0d419d",
        "statusBar.foreground": "#ffffff",
        "tab.activeBackground": "#0d1117",
        "tab.inactiveBackground": "#010409",
        "tab.activeForeground": "#e6edf3",
        "tab.inactiveForeground": "#6e7681",
        "titleBar.activeBackground": "#010409",
        "titleBar.activeForeground": "#e6edf3",
        "terminal.background": "#0d1117",
        "terminal.foreground": "#e6edf3"
    },

    "terminal.integrated.fontSize": 13,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.cursorBlinking": true,

    "python.analysis.extraPaths": [
        "..",
        "..\\src",
        "..\\HjemmeladingApp",
        "..\\modules",
        "..\\scripts",
        "..\\tools"
    ],
    "python.analysis.venvPath": "${workspaceFolder}",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.indexing": false,
    "python.analysis.autoImportCompletions": false,
    "python.analysis.useLibraryCodeForTypes": false,
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.venv",
        "**/.tool-venv",
        "**/.tool-venv-*",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.pytest_tmp",
        "**/.pytest_tmp_*",
        "**/.ruff_cache",
        "**/.claude",
        "**/tmp",
        "**/tmp_*",
        "**/test_tmp",
        "**/archive",
        "**/Hjemmelading-remote",
        "..\\build",
        "..\\build_debug",
        "..\\build_release",
        "..\\dist",
        "..\\dist_debug",
        "..\\dist_release",
        "..\\node_modules",
        "..\\logs"
    ],
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        ".",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true
}
